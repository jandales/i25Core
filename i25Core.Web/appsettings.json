{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-GOTS1E6;Database=i25Core;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "AllowRegistration": true,
    "RequireAuthenticatedByDefault": true,
    "RefreshTokenDays": 14,
    "ResetTokenMinutes": 60,
    "ResetPasswordUrl": "",
    "Jwt": {
      "Key": "",
      "Issuer": "i25Core",
      "Audience": "i25Core",
      "AccessTokenMinutes": 15
    },
    "Password": {
      "MinLength": 10,
      "MaxLength": 128,
      "HashIterations": 210000
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "BootstrapAdmin": {
      "Email": "",
      "Password": "",
      "Name": "Administrator"
    }
  },
  "Localization": {
    "DefaultLocale": "en",
    "FallbackLocale": "en",
    "Path": "lang",
    "QueryParameter": "lang",
    "HeaderName": "X-Locale",
    "ReadAcceptLanguage": true,
    "SetContentLanguageHeader": true
  },
  "Mail": {
    "Driver": "Log",
    "FromAddress": "no-reply@localhost",
    "FromName": "i25Core",
    "Queue": "default",
    "TemplatePath": "EmailTemplates",
    "LogPath": "storage/mail",
    "Smtp": {
      "Host": "localhost",
      "Port": 587,
      "Security": "Auto",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30
    }
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnection": "",
    "KeyPrefix": "i25core:",
    "DefaultDurationSeconds": 300
  },
  "BackgroundJobs": {
    "ServerEnabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/jobs",
    "WorkerCount": 0,
    "Queues": [ "default" ],
    "RetryAttempts": 3,
    "SchedulePollingIntervalSeconds": 15,
    "SchemaName": "HangFire"
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReadFromHeader": true,
    "HeaderName": "X-Api-Version",
    "ReportApiVersions": true
  },
  "Events": {
    "ThrowOnListenerError": false,
    "MaxDepth": 10
  },
  "Storage": {
    "Default": "local",
    "Disks": {
      "local": { "Driver": "Local", "Root": "storage/app" },
      "public": { "Driver": "Local", "Root": "storage/public", "Url": "/storage" }
    },
    "Uploads": {
      "MaxBytes": 10485760,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf", ".txt", ".csv", ".docx", ".xlsx" ],
      "Disk": "public"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
