{
  "ConnectionStrings": {
    "DefaultConnection": "Server=DESKTOP-GOTS1E6;Database=i25Core;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Auth": {
    "AllowRegistration": true,
    "RequireAuthenticatedByDefault": true,
    "RefreshTokenDays": 14,
    "ResetTokenMinutes": 60,
    "ResetPasswordUrl": "",
    "Jwt": {
      "Key": "",
      "Issuer": "i25Core",
      "Audience": "i25Core",
      "AccessTokenMinutes": 15
    },
    "Password": {
      "MinLength": 10,
      "MaxLength": 128,
      "HashIterations": 210000
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "BootstrapAdmin": {
      "Email": "",
      "Password": "",
      "Name": "Administrator"
    }
  },
  "Localization": {
    "DefaultLocale": "en",
    "FallbackLocale": "en",
    "Path": "lang",
    "QueryParameter": "lang",
    "HeaderName": "X-Locale",
    "ReadAcceptLanguage": true,
    "SetContentLanguageHeader": true
  },
  "Mail": {
    "Driver": "Log",
    "FromAddress": "no-reply@localhost",
    "FromName": "i25Core",
    "Queue": "default",
    "TemplatePath": "EmailTemplates",
    "LogPath": "storage/mail",
    "Smtp": {
      "Host": "localhost",
      "Port": 587,
      "Security": "Auto",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30
    }
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnection": "",
    "KeyPrefix": "i25core:",
    "DefaultDurationSeconds": 300
  },
  "BackgroundJobs": {
    "ServerEnabled": true,
    "DashboardEnabled": true,
    "DashboardPath": "/jobs",
    "WorkerCount": 0,
    "Queues": [ "default" ],
    "RetryAttempts": 3,
    "SchedulePollingIntervalSeconds": 15,
    "SchemaName": "HangFire"
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ReadFromHeader": true,
    "HeaderName": "X-Api-Version",
    "ReportApiVersions": true
  },
  "Events": {
    "ThrowOnListenerError": false,
    "MaxDepth": 10
  },
  "Storage": {
    "Default": "local",
    "Disks": {
      "local": { "Driver": "Local", "Root": "storage/app" },
      "public": { "Driver": "Local", "Root": "storage/public", "Url": "/storage" }
    },
    "Uploads": {
      "MaxBytes": 10485760,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf", ".txt", ".csv", ".docx", ".xlsx" ],
      "Disk": "public"
    }
  },
  // Log levels (Serilog). Add more "Override" lines to quiet or open up a namespace.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        // The app's own exception handler already logs every unhandled exception once, with the trace id.
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Hangfire": "Information"
      }
    }
  },
  "StructuredLogging": {
    // Auto = readable text in Development, JSON (one object per line) everywhere else. Or Text / Json.
    "ConsoleFormat": "Auto",
    "File": { "Enabled": true, "Path": "logs/log-.json", "RetainedDays": 14, "MaxFileSizeMb": 100 },
    "Requests": {
      "Enabled": true,
      "CorrelationIdHeader": "X-Correlation-Id",
      "SlowRequestMs": 2000
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // Empty = CORS off: only same-origin browser calls work (safest default). Add your front end, for example
    // "https://app.example.com". "*" means any origin and cannot be combined with AllowCredentials.
    "AllowedOrigins": [],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Accept", "Accept-Language", "X-Locale", "X-Api-Version" ],
    "ExposedHeaders": [ "WWW-Authenticate", "Content-Language", "Retry-After" ],
    "AllowCredentials": false,
    "MaxAgeSeconds": 600
  },
  "SecurityHeaders": {
    "Enabled": true,
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'",
    "ContentSecurityPolicySkipPaths": [ "/swagger", "/jobs" ],
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=()",
    "CrossOriginOpenerPolicy": "same-origin",
    "CrossOriginResourcePolicy": "same-site",
    "NoStoreForAuthResponses": true,
    "RemoveServerHeader": true,
    "Hsts": { "Enabled": true, "MaxAgeDays": 365, "IncludeSubDomains": false, "Preload": false }
  },
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health",
    "TimeoutSeconds": 5,
    "CacheSeconds": 5,
    "Database": true,
    "Storage": true,
    "BackgroundJobs": true
  },
  "RateLimiting": {
    "Enabled": true,
    // Per client address when anonymous, per user when signed in. Over the limit = 429 with Retry-After.
    "Global": {
      "Anonymous": { "PermitLimit": 60, "WindowSeconds": 60 },
      "Authenticated": { "PermitLimit": 300, "WindowSeconds": 60 }
    },
    // Named limits for [EnableRateLimiting("name")]. "auth" protects sign-in, register and password reset.
    "Policies": {
      "auth": { "PermitLimit": 10, "WindowSeconds": 60 },
      "strict": { "PermitLimit": 5, "WindowSeconds": 60 }
    },
    "ExemptPaths": [ "/health" ],
    "SegmentsPerWindow": 6
  },
  "ForwardedHeaders": {
    // Turn on only behind a reverse proxy / load balancer, and list it. Without a list anyone could fake their address.
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
